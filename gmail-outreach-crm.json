    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const data = item.json;\n\n  // Отримуємо email одержувача\n  const to = data.To || '';\n  const match = to.match(/<([^>]+)>/);\n  const email = (match ? match[1] : to)\n    .trim()\n    .toLowerCase();\n\n  // Отримуємо домен пошти\n  const domain = email.split('@')[1] || '';\n\n  // Перетворюємо дату листа\n  const sentDate = new Date(\n    Number(data.internalDate)\n  ).toISOString();\n\n  return {\n    json: {\n      Email: email,\n      Domain: domain,\n      SentDate: sentDate,\n      GmailMessageId: data.id\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        0
      ],
      "id": "313ba995-9a9a-4716-b0aa-599d33cfee93",
      "name": "Code - Prepare Email Data"
    },
