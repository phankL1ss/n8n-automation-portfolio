    {
      "parameters": {
        "jsCode": "\nconst messages = $(\"Gmail - Get Sent Emails\").all();\n\nconst timestamps = messages\n  .map(item => Number(item.json.internalDate))\n  .filter(Number.isFinite);\n\nif (timestamps.length === 0) {\n  return [];\n}\n\n// Час найновішого обробленого листа\nconst latest = Math.max(...timestamps);\n\n// Попередня дата синхронізації\nconst previous = Date.parse(\n  $(\"Google Sheets - Get Sync State\").first().json.LastProcessedAt\n);\n\n// Залишаємо запас 1 хвилину,\n// щоб не пропустити листи на межі синхронізації\nconst checkpoint = Math.max(\n  Number.isFinite(previous) ? previous : 0,\n  latest - 60000\n);\n\nreturn [{\n  json: {\n    Key: \"outreach\",\n    LastProcessedAt: new Date(checkpoint).toISOString()\n  }\n}];\n"
      },
