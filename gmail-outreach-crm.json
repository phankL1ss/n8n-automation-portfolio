      "id": "d29024b8-8440-4054-9340-4185dc5dc25c",
      "name": "Google Sheets - Get Existing Contacts",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "\nconst emails = $(\"Code - Prepare Email Data\").all().map(i => i.json);\n\nconst saved = new Map(\n  $input.all()\n    .map(i => i.json)\n    .filter(r => r.Email)\n    .map(r => [String(r.Email).trim().toLowerCase(), r])\n);\n\n// Форматуємо дату за київським часом\nfunction formatDate(value) {\n  if (!value) return \"\";\n\n  const text = String(value).trim();\n\n  // Дата без секунд\n  if (/^\\d{2}\\.\\d{2}\\.\\d{4} \\d{2}:\\d{2}$/.test(text)) {\n    return text;\n  }\n\n  // Дата із секундами, які додає Google Sheets\n  if (/^\\d{2}\\.\\d{2}\\.\\d{4} \\d{2}:\\d{2}:\\d{2}$/.test(text)) {\n    return text.slice(0, 16);\n  }\n\n  const date = new Date(text);\n\n  if (isNaN(date.getTime())) {\n    throw new Error(\"Invalid date: \" + text);\n  }\n\n  const parts = new Intl.DateTimeFormat(\"en-GB\", {\n    timeZone: \"Europe/Kyiv\",\n    day: \"2-digit\",\n    month: \"2-digit\",\n    year: \"numeric\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    hourCycle: \"h23\"\n  }).formatToParts(date);\n\n  const p = Object.fromEntries(\n    parts.map(x => [x.type, x.value])\n  );\n\n  return `${p.day}.${p.month}.${p.year} ${p.hour}:${p.minute}`;\n}\n\n// Перетворення дати для правильного порівняння\nfunction dateKey(value) {\n  const formatted = formatDate(value);\n  const [date, time] = formatted.split(\" \");\n  const [day, month, year] = date.split(\".\");\n\n  return `${year}-${month}-${day} ${time}`;\n}\n\nconst changes = new Map();\n\nfor (const mail of emails) {\n  const email = String(mail.Email || \"\").trim().toLowerCase();\n\n  if (!email || !mail.SentDate) continue;\n\n  const date = formatDate(mail.SentDate);\n  const old = changes.get(email) || saved.get(email);\n\n  // Новий контакт\n  if (!old) {\n    changes.set(email, {\n      Company: \"\",\n      Email: email,\n      Domain: mail.Domain || \"\",\n      \"First Contact\": date,\n      \"Last Contact\": date,\n      Status: \"Надіслано\"\n    });\n\n    continue;\n  }\n\n  // Існуючий контакт\n  const previousFirst = formatDate(old[\"First Contact\"] || date);\n  const previousLast = formatDate(old[\"Last Contact\"] || date);\n\n  const first = dateKey(date) < dateKey(previousFirst)\n    ? date\n    : previousFirst;\n\n  const last = dateKey(date) > dateKey(previousLast)\n    ? date\n    : previousLast;\n\n  // Оновлюємо дати, але зберігаємо статус і назву\n  changes.set(email, {\n    Company: old.Company || \"\",\n    Email: email,\n    Domain: old.Domain || mail.Domain || \"\",\n    \"First Contact\": first,\n    \"Last Contact\": last,\n    Status: old.Status || \"Надіслано\"\n  });\n}\n\nreturn [...changes.values()].map(json => ({ json }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
