      "id": "a8e6869b-1d6f-4f0f-b32e-f255c94466b1",
      "name": "Отримати мої нотатки",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const ai = $('AI — Розуміння повідомлення').first().json.output;\n\nconst notes = $input.all()\n  .map(item => item.json)\n  .filter(note => typeof note.content === 'string' && note.content.trim());\n\nlet text;\n\nif (ai.intent === 'find_note') {\n  const query = String(ai.content ?? '').trim().toLowerCase();\n\n  const found = query\n    ? notes.filter(note =>\n        note.content.toLowerCase().includes(query)\n      )\n    : [];\n\n  if (found.length === 0) {\n    text = '🔎 Нічого не знайдено за запитом: ' + (query || 'порожній запит');\n  } else {\n    const list = found\n      .map((note, index) => `${index + 1}. ${note.content}`)\n      .join('\\n\\n');\n\n    text = `🔎 Знайдено нотаток: ${found.length}\\n\\n${list}`;\n  }\n\n} else {\n  if (notes.length === 0) {\n    text = '📭 У тебе поки немає нотаток.';\n  } else {\n    const list = notes\n      .map((note, index) => `${index + 1}. ${note.content}`)\n      .join('\\n\\n');\n\n    text = `📝 Твої нотатки (${notes.length})\\n\\n${list}`;\n  }\n}\n\nreturn [{ json: { text } }];"
      },
