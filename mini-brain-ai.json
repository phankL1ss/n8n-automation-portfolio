    {
      "parameters": {
        "jsCode": "const events = $input.all()\n  .map(item => item.json)\n  .filter(event =>\n    event.start &&\n    (event.start.dateTime || event.start.date) &&\n    event.status !== 'cancelled'\n  );\n\nevents.sort((a, b) => {\n  const dateA = a.start.dateTime || a.start.date;\n  const dateB = b.start.dateTime || b.start.date;\n  return dateA.localeCompare(dateB);\n});\n\nconst formatDate = (event) => {\n  if (event.start.date) {\n    return event.start.date.split('-').reverse().join('.');\n  }\n\n  return new Intl.DateTimeFormat('uk-UA', {\n    timeZone: 'Europe/Kyiv',\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric'\n  }).format(new Date(event.start.dateTime));\n};\n\nconst formatTime = (event) => {\n  if (!event.start.dateTime) {\n    return 'Увесь день';\n  }\n\n  return new Intl.DateTimeFormat('uk-UA', {\n    timeZone: 'Europe/Kyiv',\n    hour: '2-digit',\n    minute: '2-digit',\n    hourCycle: 'h23'\n  }).format(new Date(event.start.dateTime));\n};\n\nlet text;\n\nif (events.length === 0) {\n  text = '📭 На вибраний період планів немає.';\n} else {\n  const list = events.map((event, index) => {\n    const date = formatDate(event);\n    const time = formatTime(event);\n    const title = event.summary || 'Без назви';\n\n    return `${index + 1}. 📅 ${date}\\n🕒 ${time} — ${title}`;\n  }).join('\\n\\n');\n\n  text = `📋 Твої плани (${events.length})\\n\\n${list}`;\n}\n\nif (text.length > 3800) {\n  text = text.slice(0, 3700) + '\\n\\n… Список скорочено.';\n}\n\nreturn [{ json: { text } }];"
      },
